generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Household {
  id        String             @id @default(cuid())
  name      String
  createdAt DateTime           @default(now())
  users     User[]
  recurring RecurringExpense[]
  settings  HouseholdSetting[]
}

model User {
  id                String             @id @default(cuid())
  name              String
  // Nullable so `prisma db push` upgrades a pre-household database in place;
  // ensureLegacyHousehold() backfills it on the first request after deploy.
  householdId       String?
  household         Household?         @relation(fields: [householdId], references: [id])
  createdAt         DateTime           @default(now())
  paidExpenses      Expense[]          @relation("payer")
  shares            ExpenseShare[]
  paymentsFrom      Settlement[]       @relation("from")
  paymentsTo        Settlement[]       @relation("to")
  recurringDefaults RecurringExpense[] @relation("recurringDefaultPayer")

  @@unique([householdId, name])
  @@index([householdId])
}

model Category {
  id                String             @id @default(cuid())
  name              String             @unique
  icon              String?
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
}

model Expense {
  id                 String            @id @default(cuid())
  amount             Int
  currency           String            @default("USD")
  payerId            String
  payer              User              @relation("payer", fields: [payerId], references: [id])
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id])
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  note               String?
  receiptUrl         String?
  date               DateTime
  createdAt          DateTime          @default(now())
  createdById        String?
  shares             ExpenseShare[]

  @@index([date])
  @@index([payerId])
  @@index([categoryId])
  @@index([recurringExpenseId])
}

model ExpenseShare {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  amount    Int

  @@unique([expenseId, userId])
  @@index([userId])
}

model Settlement {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("from", fields: [fromId], references: [id])
  toId      String
  to        User     @relation("to", fields: [toId], references: [id])
  amount    Int
  currency  String   @default("USD")
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
}

// Legacy global key-value store from the single-household era. Kept as the
// source for the lazy migration; new per-household values live in
// HouseholdSetting.
model Setting {
  key   String @id
  value String
}

model HouseholdSetting {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  key         String
  value       String

  @@unique([householdId, key])
}

model RecurringExpense {
  id             String     @id @default(cuid())
  name           String
  kind           String     @default("fixed")
  defaultCents   Int        @default(0)
  currency       String     @default("USD")
  // Nullable for the same lazy-migration reason as User.householdId.
  householdId    String?
  household      Household? @relation(fields: [householdId], references: [id])
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  defaultPayerId String?
  defaultPayer   User?     @relation("recurringDefaultPayer", fields: [defaultPayerId], references: [id])
  dueDay         Int?
  sharesBp       String
  sortOrder      Int       @default(0)
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  expenses       Expense[]

  @@index([archived])
  @@index([sortOrder])
  @@index([householdId])
}
