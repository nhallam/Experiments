# Neon Postgres — use the "pooled" connection string here
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection string, required by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Vercel Blob — create a store in the Vercel dashboard, then copy the token
BLOB_READ_WRITE_TOKEN=""
