# Neon Postgres. Env var names match what Vercel's Neon integration injects
# automatically, so no manual renaming is needed once the integration is
# connected in the Vercel dashboard.
# DATABASE_URL = pooled connection string (used at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# DATABASE_URL_UNPOOLED = direct connection, used by Prisma for migrations /
# schema sync. Neon calls this the "direct" connection string.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Vercel Blob — auto-injected by the Vercel Blob integration.
BLOB_READ_WRITE_TOKEN=""

# Weekly snapshot job (see vercel.json).
# IANA timezone the household lives in. Determines the Mon–Sun week boundaries
# and "Sunday night" for the snapshot. Defaults to America/New_York if unset.
APP_TIMEZONE="America/New_York"
# Shared secret Vercel Cron sends as a Bearer token to the snapshot endpoint.
# Set this in the Vercel project so only the cron can trigger the job.
CRON_SECRET=""
